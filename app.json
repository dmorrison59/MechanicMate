{
  "expo": {
    "name": "MechanicMate",
    "slug": "mechanicmate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mechanicmate.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "10"
    },
    "android": {
      "package": "com.mechanicmate.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MechanicMate to scan your vehicle identification number.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a47b7ea0-c6b9-4ae8-998b-9217dc417a38"
      }
    },
    "owner": "dmorrison7195"
  }
}
